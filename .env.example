# Supabase
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-KEY
# New Supabase projects use sb_secret_* keys. Set ONE of these (service_role / secret):
# SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
SUPABASE_SECRET_KEY=YOUR-SECRET-KEY
# Optional: bucket defaults to research-files when unset. Create it in
# Supabase Dashboard -> Storage -> Buckets (private) if it doesn't exist.
SUPABASE_STORAGE_BUCKET=research-files
# Research PDF attachments are stored under the pdfs/ folder in this bucket.

# Postgres connection pool (Supabase Dashboard -> Project Settings -> Database -> Connection string)
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:6543/postgres

# JWT
JWT_SECRET=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# Google Drive backup & recovery
# ---------------------------------------------------------------------------
# Google Cloud -> APIs & Services -> Credentials -> OAuth 2.0 Client (Web application)
GOOGLE_CLIENT_ID=YOUR-GOOGLE-OAUTH-CLIENT-ID
GOOGLE_CLIENT_SECRET=YOUR-GOOGLE-OAUTH-CLIENT-SECRET
APP_URL=https://research-nu-woad.vercel.app
GOOGLE_REDIRECT_URI=https://research-nu-woad.vercel.app/api/auth/google/callback
GOOGLE_DRIVE_FOLDER_NAME=ResearchHub Backups
# Optional: defaults to drive.file. Keep this minimal unless you need more.
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/drive.file

# 32-byte encryption key for refresh tokens and backup files.
# Generate with: openssl rand -base64 32
# Changing this key makes existing encrypted refresh tokens/backups unreadable.
BACKUP_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

# Worker-only: use a DIRECT/session connection (port 5432), not the 6543 pooler.
# If omitted the worker falls back to DATABASE_URL. A Supabase transaction pooler
# URL on port 6543 is automatically upgraded to the session pooler on port 5432.
BACKUP_DATABASE_URL=postgresql://postgres:YOUR-DB-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# Worker-only: a separate staging database for restore validation. Never point
# this at production. The worker refuses matching/unsafe targets.
RESTORE_STAGING_DATABASE_URL=postgresql://postgres:STAGING-PASSWORD@STAGING-HOST:5432/researchhub_staging

# Vercel Cron authentication. Vercel sends: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=change-me-to-a-long-random-string

# Optional worker start webhook (GitHub Actions repository_dispatch, Render, etc.)
# GitHub Actions example (token needs Contents: Read and write):
# BACKUP_TRIGGER_WEBHOOK_URL=https://api.github.com/repos/OWNER/REPO/dispatches
# BACKUP_TRIGGER_WEBHOOK_TOKEN=YOUR-FINE-GRAINED-PAT
BACKUP_TRIGGER_WEBHOOK_URL=
BACKUP_TRIGGER_WEBHOOK_TOKEN=

# Optional failure/alert webhook
BACKUP_ALERT_WEBHOOK_URL=
BACKUP_ALERT_WEBHOOK_TOKEN=

# Optional worker tuning
# BACKUP_PG_SCHEMAS=public
# BACKUP_PG_DUMP_INCLUDE_OWNERS=0
# PG_DUMP_TIMEOUT_MS=1800000
# PG_RESTORE_TIMEOUT_MS=2700000
# BACKUP_TEMP_DIR=C:\temp\researchhub-backups
# RESTORE_ALLOW_SAME_HOST=0
# RESTORE_ALLOW_PROD_NAME=0
# RESTORE_ALLOW_NON_STAGING=0
# Set to 1 only if a non-Supabase pooler genuinely supports pg_dump on 6543.
# BACKUP_ALLOW_POOLER=0
